from fpdf import FPDF
from fpdf.enums import XPos, YPos
import math, os

class TAMGA_PDF(FPDF):
    def __init__(self):
        super().__init__(orientation='L', unit='mm', format='A4')
        self.set_auto_page_break(False)
        self.set_margins(0, 0, 0)

    def bg_dark(self):
        self.set_fill_color(15, 13, 12)
        self.rect(0, 0, 297, 210, 'F')
        self.set_fill_color(226, 185, 125)
        self.rect(0, 0, 3, 210, 'F')

    def kicker(self, text, y=22):
        self.set_text_color(226, 185, 125)
        self.set_font("Helvetica", "B", 9)
        self.set_xy(22, y)
        self.cell(0, 0, text)

    def gold_line(self, x=22, y=58, w=100):
        self.set_fill_color(226, 185, 125)
        self.rect(x, y, w, 0.7, 'F')

    def logo(self, cx, cy, r=40):
        self.set_draw_color(226, 185, 125)
        self.set_line_width(0.5)
        self.ellipse(cx-r, cy-r, r*2, r*2)
        ri = r * 0.45
        self.ellipse(cx-ri, cy-ri, ri*2, ri*2)
        rd = r * 0.08
        self.set_fill_color(226, 185, 125)
        self.ellipse(cx-rd, cy-rd, rd*2, rd*2, 'F')
        for a in [0, 90, 180, 270]:
            rad = math.radians(a)
            mx = cx + (r*0.7) * math.cos(rad)
            my = cy + (r*0.7) * math.sin(rad)
            self.ellipse(mx-0.8, my-0.8, 1.6, 1.6, 'F')

